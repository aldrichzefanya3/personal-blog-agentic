# =============================================================================
# Personal Blog — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Project URL
# Found in: Supabase Dashboard → Settings → API → Project URL
# Example:  https://xyzabcdef.supabase.co
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co

# -----------------------------------------------------------------------------
# Supabase — Anon (public) key
# Safe to expose in browser code; restricted by Row Level Security policies.
# Found in: Supabase Dashboard → Settings → API → Project API keys → anon / public
# -----------------------------------------------------------------------------
SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Supabase — Public URL and anon key for browser (Client Component) usage.
# These NEXT_PUBLIC_ variants are required so that the values are included in
# the browser bundle.  The anon key is intentionally public — it is scoped
# to anonymous/public RLS policies and grants no privileged access.
# Set these to the same values as SUPABASE_URL and SUPABASE_ANON_KEY above.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# Supabase — Service role key
# NEVER expose this in browser code or commit it to version control.
# Bypasses Row Level Security — only use in trusted server-side contexts.
# Found in: Supabase Dashboard → Settings → API → Project API keys → service_role
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# PostgreSQL — Transaction Pooler URL  (RUNTIME — used by the app)
#
# MUST point to Supabase's Transaction Pooler (Supavisor), port 6543.
# This dramatically reduces cold-start latency for serverless deployments by
# reusing pre-warmed server-side connections instead of opening a raw TCP
# socket to Postgres on every request.
#
# Found in: Supabase Dashboard → Settings → Database → Connection pooling
#           → Connection string (Transaction mode)
# Always append: ?pgbouncer=true  (disables prepared-statement protocol)
#
# Example: postgresql://postgres.[ref]:[pw]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.hafcpjmpcgffrkkuxief:c1UmwzwEHUxU45bc@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# -----------------------------------------------------------------------------
# PostgreSQL — Direct connection URL  (MIGRATIONS ONLY — drizzle-kit)
#
# Points directly to Postgres, port 5432. Required by drizzle-kit for schema
# migrations because Supavisor transaction mode doesn't support DDL over the
# pooler. This URL is NEVER used by the app at runtime.
#
# Found in: Supabase Dashboard → Settings → Database → Connection string
#           → URI (direct)
#
# Example: postgresql://postgres:[pw]@db.[ref].supabase.co:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_DIRECT_URL=postgresql://postgres:c1UmwzwEHUxU45bc@db.your-project-ref.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# Public site URL — used for canonical links, Open Graph, and sitemap generation.
# In development this is typically http://localhost:8000.
# In production set this to your deployed domain (e.g. https://yourblog.com).
# This variable is prefixed with NEXT_PUBLIC_ so it is available in the browser.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Admin Signup Secret — One-time token for secure admin account creation
# This secret enables the first admin user to be created via /auth/setup-admin.
# After the first admin is created, the setup route becomes inaccessible (404).
# Generate a secure random token with: openssl rand -hex 32
# Keep this secret secure and communicate it out-of-band to the blog owner.
# -----------------------------------------------------------------------------
ADMIN_SIGNUP_SECRET=your-random-secret-here-generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# Scheduled AI Writer (optional; keep all keys and bot tokens server-side)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
AI_WRITER_CRON_SECRET=generate-a-separate-random-secret
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-private-chat-id
TELEGRAM_ALLOWED_USER_ID=your-telegram-user-id
TELEGRAM_WEBHOOK_SECRET=generate-a-random-telegram-webhook-secret
